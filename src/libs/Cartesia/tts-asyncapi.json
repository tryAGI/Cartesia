{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Cartesia Realtime Text-to-Speech WebSocket API",
    "version": "2026-08-14",
    "description": "Generate audio in realtime with contexts"
  },
  "servers": {
    "production": {
      "host": "api.cartesia.ai",
      "pathname": "/tts/websocket",
      "protocol": "wss",
      "description": "Cartesia realtime text-to-speech WebSocket endpoint.",
      "variables": {
        "cartesia_version": {
          "description": "Cartesia API version.",
          "default": "2026-08-14"
        }
      },
      "security": [
        {
          "$ref": "#/components/securitySchemes/apiKey"
        },
        {
          "$ref": "#/components/securitySchemes/accessToken"
        }
      ]
    }
  },
  "channels": {
    "textToSpeech": {
      "address": "/tts/websocket",
      "messages": {
        "GenerationRequest": {
          "$ref": "#/components/messages/GenerationRequest"
        },
        "CancelRequest": {
          "$ref": "#/components/messages/CancelRequest"
        },
        "ChunkResponse": {
          "$ref": "#/components/messages/ChunkResponse"
        },
        "FlushDoneResponse": {
          "$ref": "#/components/messages/FlushDoneResponse"
        },
        "GenerationDoneResponse": {
          "$ref": "#/components/messages/GenerationDoneResponse"
        },
        "TimestampsResponse": {
          "$ref": "#/components/messages/TimestampsResponse"
        },
        "PhonemeTimestampsResponse": {
          "$ref": "#/components/messages/PhonemeTimestampsResponse"
        },
        "TTSErrorResponse": {
          "$ref": "#/components/messages/TTSErrorResponse"
        }
      }
    }
  },
  "operations": {
    "sendGenerationRequest": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/textToSpeech"
      },
      "messages": [
        {
          "$ref": "#/channels/textToSpeech/messages/GenerationRequest"
        }
      ]
    },
    "sendCancelRequest": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/textToSpeech"
      },
      "messages": [
        {
          "$ref": "#/channels/textToSpeech/messages/CancelRequest"
        }
      ]
    },
    "receiveChunkResponse": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/textToSpeech"
      },
      "messages": [
        {
          "$ref": "#/channels/textToSpeech/messages/ChunkResponse"
        }
      ]
    },
    "receiveFlushDoneResponse": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/textToSpeech"
      },
      "messages": [
        {
          "$ref": "#/channels/textToSpeech/messages/FlushDoneResponse"
        }
      ]
    },
    "receiveGenerationDoneResponse": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/textToSpeech"
      },
      "messages": [
        {
          "$ref": "#/channels/textToSpeech/messages/GenerationDoneResponse"
        }
      ]
    },
    "receiveTimestampsResponse": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/textToSpeech"
      },
      "messages": [
        {
          "$ref": "#/channels/textToSpeech/messages/TimestampsResponse"
        }
      ]
    },
    "receivePhonemeTimestampsResponse": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/textToSpeech"
      },
      "messages": [
        {
          "$ref": "#/channels/textToSpeech/messages/PhonemeTimestampsResponse"
        }
      ]
    },
    "receiveTTSErrorResponse": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/textToSpeech"
      },
      "messages": [
        {
          "$ref": "#/channels/textToSpeech/messages/TTSErrorResponse"
        }
      ]
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key for trusted server applications."
      },
      "accessToken": {
        "type": "apiKey",
        "in": "query",
        "name": "access_token",
        "description": "Short-lived token for browser and mobile applications."
      }
    },
    "messages": {
      "GenerationRequest": {
        "name": "GenerationRequest",
        "title": "Generation Request",
        "description": "Use this to generate speech for a transcript.",
        "contentType": "application/json",
        "payload": {
          "$ref": "#/components/schemas/GenerationRequest"
        }
      },
      "CancelRequest": {
        "name": "CancelRequest",
        "title": "Cancel Context Request",
        "description": "Use this to cancel a context, so that no more messages are generated for that context.",
        "contentType": "application/json",
        "payload": {
          "$ref": "#/components/schemas/CancelRequest"
        }
      },
      "ChunkResponse": {
        "name": "ChunkResponse",
        "title": "Audio Chunk Response",
        "description": "Audio data chunk",
        "contentType": "application/json",
        "payload": {
          "$ref": "#/components/schemas/ChunkResponse"
        }
      },
      "FlushDoneResponse": {
        "name": "FlushDoneResponse",
        "title": "Flush Done Response",
        "description": "Acknowledgment that flush command was received. See [Context Flushing](/use-the-api/tts-websocket/context-flushing-and-flush-i-ds) for details.",
        "contentType": "application/json",
        "payload": {
          "$ref": "#/components/schemas/FlushDoneResponse"
        }
      },
      "GenerationDoneResponse": {
        "name": "GenerationDoneResponse",
        "title": "Done Response",
        "description": "Generation completion signal",
        "contentType": "application/json",
        "payload": {
          "$ref": "#/components/schemas/GenerationDoneResponse"
        }
      },
      "TimestampsResponse": {
        "name": "TimestampsResponse",
        "title": "Word Timestamps Response",
        "description": "Word-level timing information",
        "contentType": "application/json",
        "payload": {
          "$ref": "#/components/schemas/TimestampsResponse"
        }
      },
      "PhonemeTimestampsResponse": {
        "name": "PhonemeTimestampsResponse",
        "title": "Phoneme Timestamps Response",
        "description": "Phoneme-level timing information",
        "contentType": "application/json",
        "payload": {
          "$ref": "#/components/schemas/PhonemeTimestampsResponse"
        }
      },
      "TTSErrorResponse": {
        "name": "TTSErrorResponse",
        "title": "Error Response",
        "description": "Error information for TTS WebSocket connections.",
        "contentType": "application/json",
        "payload": {
          "$ref": "#/components/schemas/TTSErrorResponse"
        }
      }
    },
    "schemas": {
      "GenerationRequest": {
        "type": "object",
        "required": [
          "model_id",
          "transcript",
          "voice",
          "output_format",
          "context_id"
        ],
        "properties": {
          "model_id": {
            "type": "string",
            "enum": [
              "sonic-3.6",
              "sonic-3.5",
              "sonic-3",
              "sonic-latest"
            ],
            "example": "sonic-3.6",
            "description": "The ID of the model to use for the generation. See [Models](/build-with-cartesia/tts-models/latest) for all options."
          },
          "transcript": {
            "type": "string",
            "description": "Transcript chunk to add to the audio being generated by this context."
          },
          "voice": {
            "description": "The voice to use for generation. Pass either a voice ID string or an object with a required `id` (additional object fields may be added in future API versions). Use the same value for all generation requests made to the same context. Embeddings are not accepted in this API version.",
            "oneOf": [
              {
                "type": "string",
                "title": "TTSRequestVoiceId",
                "description": "The ID of the voice.",
                "example": "a0e99841-438c-4a64-b679-ae501e7d6091"
              },
              {
                "type": "object",
                "title": "TTSRequestVoiceObject",
                "description": "Voice object. `id` is required; other fields may be added in future API versions.",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The ID of the voice.",
                    "example": "a0e99841-438c-4a64-b679-ae501e7d6091"
                  }
                },
                "additionalProperties": true
              }
            ]
          },
          "output_format": {
            "type": "object",
            "description": "Audio output format configuration. Use the same value for all generation requests made to the same context.",
            "required": [
              "container",
              "encoding",
              "sample_rate"
            ],
            "properties": {
              "container": {
                "type": "string",
                "enum": [
                  "raw"
                ],
                "description": "Audio container format",
                "default": "raw"
              },
              "encoding": {
                "type": "string",
                "enum": [
                  "pcm_f32le",
                  "pcm_s16le",
                  "pcm_mulaw",
                  "pcm_alaw"
                ],
                "description": "Audio encoding format. See [TTS Output Audio Format](/build-with-cartesia/capability-guides/tts-output-audio-format) if you're unsure what to use."
              },
              "sample_rate": {
                "type": "integer",
                "enum": [
                  8000,
                  16000,
                  22050,
                  24000,
                  44100,
                  48000
                ],
                "description": "Audio sample rate in Hz."
              }
            }
          },
          "language": {
            "type": "string",
            "description": "The transcript's language or locale. Use a base language code such as `en` or a regional locale code such as `en-GB`. `language` and `locale` accept the same values. Set one or the other, never both; setting both returns an error. The enum lists canonical codes; matching is case-insensitive, and underscore locale aliases such as `en_GB` are also accepted. See [supported codes](/build-with-cartesia/capability-guides/advanced-capabilities#which-locales-are-supported).",
            "enum": [
              "en",
              "fr",
              "de",
              "es",
              "pt",
              "zh",
              "ja",
              "hi",
              "it",
              "ko",
              "nl",
